DEMO_MODE=true
VITE_ENABLE_DEMO_CHECKOUT=true

ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-admin-password

RAZORPAY_KEY_ID=
