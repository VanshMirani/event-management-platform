CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=event_management
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_management?schema=public"

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
COOKIE_DOMAIN=

# The submitted project uses Razorpay Test Mode. Keep both demo flags false.
# Only rzp_test_ keys are accepted by the server.
DEMO_MODE=false
VITE_ENABLE_DEMO_CHECKOUT=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-admin-password

RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_test_webhook_secret
