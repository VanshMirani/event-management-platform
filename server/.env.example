NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_management?schema=public"
CLIENT_ORIGIN=http://localhost:5173

# JWT auth with httpOnly cookies.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
COOKIE_DOMAIN=

# No-charge checkout for this project submission. Disable for real payments.
DEMO_MODE=true

ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-admin-password

# Razorpay integration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
